  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Multiplayer:\r\n\r\nPara jogar o jogo, no momento, \xE9 necess\xE1rio
    que sua Steam esteja aberta, e, se quiser jogar com mais de um jogador, as m\xE1quinas
    devem ter acesso \xE0 Steam e devem estar em contas adicionadas como amigos.\r\n\r\nPrimeiro,
    no menu principal, um jogador deve clicar em Host Game para criar um lobby. Se
    ele quiser jogar sozinho, deve apenas clicar em Ready, e ent\xE3o em Start Game.
    Se quiser que outro jogador entre no lobby, pode convid\xE1-lo atrav\xE9s do
    sistema de amigos da Steam (o bot\xE3o Invite Friend abre esse sistema automaticamente),
    ou o outro jogador, ainda no menu principal, pode clicar em Enter Room, que abrir\xE1
    o mesmo sistema de amigos da Steam, e clicar para entrar na partida do amigo
    que j\xE1 est\xE1 no lobby. Quando estiverem no lobby, basta apertar Ready e
    esperar que o host da sala inicie o jogo quando todos estiverem prontos."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 1ab574a226bf0ca4da5cded3bb84e061, type: 2}
