#define VFX_USE_ANGLEY_CURRENT 1
#define VFX_USE_ANGLEZ_CURRENT 1
#define RAW_CAPACITY 1u
#define USE_BASE_COLOR_MAP 1
#define USE_BASE_COLOR_MAP_COLOR 1
